    <meta property="og:url" content="https://[YOUR_DOMAIN]/" />
    <meta property="og:image" content="https://[YOUR_DOMAIN]/sbloom-logo-v2.jpg" />
    <meta property="og:site_name" content="S-Bloom" />

    <!-- Twitter Card Meta Tags -->
