    <meta name="twitter:title" content="S-Bloom | Digital Growth Partner" />
    <meta name="twitter:description" content="You have the expertise. We make it easier to discover, understand, and choose." />
    <meta name="twitter:image" content="https://[YOUR_DOMAIN]/sbloom-logo-v2.jpg" />

    <!-- Canonical Link Placeholder -->
